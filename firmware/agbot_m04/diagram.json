{
  "version": 1,
  "author": "Terra Sana",
  "editor": "wokwi",
  "parts": [
    { "type": "board-esp32-devkit-c-v4", "id": "esp", "top": 0, "left": 0, "attrs": {} },
    { "type": "wokwi-potentiometer", "id": "pot1", "top": -60, "left": 180, "attrs": { "label": "Corrente" } },
    { "type": "wokwi-potentiometer", "id": "pot2", "top": 60, "left": 180, "attrs": { "label": "Umidade" } },
    { "type": "wokwi-pushbutton", "id": "btn1", "top": 190, "left": 180, "attrs": { "color": "red", "label": "Emergência" } },
    { "type": "wokwi-led", "id": "led1", "top": -70, "left": -60, "attrs": { "color": "green", "label": "Operando" } },
    { "type": "wokwi-resistor", "id": "r1", "top": 20, "left": -90, "rotate": 90, "attrs": { "value": "220" } }
  ],
  "connections": [
    [ "esp:TX", "$serialMonitor:RX", "", [] ],
    [ "esp:RX", "$serialMonitor:TX", "", [] ],
    [ "pot1:GND", "esp:GND.1", "black", [] ],
    [ "pot1:VCC", "esp:3V3", "red", [] ],
    [ "pot1:SIG", "esp:34", "green", [] ],
    [ "pot2:GND", "esp:GND.1", "black", [] ],
    [ "pot2:VCC", "esp:3V3", "red", [] ],
    [ "pot2:SIG", "esp:35", "blue", [] ],
    [ "btn1:1.l", "esp:4", "orange", [] ],
    [ "btn1:2.l", "esp:GND.2", "black", [] ],
    [ "led1:A", "r1:1", "green", [] ],
    [ "r1:2", "esp:2", "green", [] ],
    [ "led1:C", "esp:GND.1", "black", [] ]
  ]
}
